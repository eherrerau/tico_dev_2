{
    "name": "tico/ticket-management-system",
    "description": "TICO - Tickets Control Center - Modernized PHP Application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.5",
        "ramsey/uuid": "^4.7",
        "monolog/monolog": "^3.4",
        "twig/twig": "^3.7",
        "symfony/http-foundation": "^6.3",
        "respect/validation": "^2.2"
    },
    "suggest": {
        "ext-pdo_sqlsrv": "Required for SQL Server connectivity in production"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Tico\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tico\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
