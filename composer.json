{
    "name": "tico/ticket-management-system",
    "description": "TICO - Tickets Control Center - Modernized PHP Application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6",
        "ramsey/uuid": "^4.9",
        "monolog/monolog": "^3.9",
        "twig/twig": "^3.21",
        "symfony/http-foundation": "^7.3",
        "symfony/console": "^7.3",
        "respect/validation": "^2.4",
        "league/csv": "^9.16",
        "nesbot/carbon": "^3.8"
    },
    "suggest": {
        "ext-pdo_sqlsrv": "Required for SQL Server connectivity in production"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^1.12",
        "phpstan/extension-installer": "^1.4",
        "squizlabs/php_codesniffer": "^3.10",
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan-symfony": "^1.4",
        "phpstan/phpstan-strict-rules": "^1.6",
        "rector/rector": "^1.2",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Tico\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tico\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:phpunit": "phpunit",
        "phpstan": "phpstan analyse src --level=9",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "cs-fix-modern": "php-cs-fixer fix",
        "rector": "rector process",
        "rector:dry": "rector process --dry-run",
        "quality": [
            "@phpstan",
            "@cs-check",
            "@test"
        ],
        "fix": [
            "@cs-fix-modern",
            "@rector"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
