# Environment Configuration
APP_NAME="TICO - Tickets Control Center"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=TICO_DB
DB_USERNAME=
DB_PASSWORD=

# Global Database
DB_GLOBAL_DATABASE=TICO_Global

# Security
APP_KEY=base64:CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Timezone
APP_TIMEZONE=America/Costa_Rica

# Logging
LOG_CHANNEL=file
LOG_LEVEL=debug

# Cache
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync
